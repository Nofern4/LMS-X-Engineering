# Database configuration
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional for high performance)
REDIS_URL="redis://localhost:6379"

# Storage Adapter Configuration (local vs s3)
STORAGE_TYPE="local" # "local" | "s3"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="lms-materials"
STORAGE_LOCAL_DIR="./uploads"

# Institutional Security & Domain Policy
ALLOWED_EMAIL_DOMAINS="@student.institution.ac.th,@institution.ac.th"
COURSE_STORAGE_LIMIT_GB=10

# Auth & Security
AUTH_SECRET="institutional-lms-super-secret-key-2026"
DEV_DEMO_AUTH=true # Set to false in production

# App Info
NEXT_PUBLIC_APP_NAME="สถาบันการศึกษา LMS / E-Learning System"
